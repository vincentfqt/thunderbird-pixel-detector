{
	"name": "thunderbird-pixel-detector",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "node scripts/check-version.mjs && tsc --noEmit && vite build",
		"build:watch": "node scripts/check-version.mjs && vite build --watch",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"test": "vitest",
		"tb": "pnpm build",
		"tb:lint": "pnpm build && web-ext lint --source-dir=dist",
		"tb:build": "pnpm build && web-ext build --source-dir=dist --artifacts-dir=artifacts --overwrite-dest",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/firefox-webext-browser": "^143.0.1",
		"@types/node": "^26.6.5",
		"typescript": "~7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"web-ext": "^10.7.0"
	}
}
