{
	"manifest_version": 3,
	"name": "Thunderbird Pixel Detector",
	"description": "Détecte les pixels de suivi présents dans les courriels.",
	"version": "0.1.0",
	"author": "Vincent Fqt",
	"browser_specific_settings": {
		"gecko": {
			"id": "thunderbird-pixel-detector@vincentfqt.dev",
			"strict_min_version": "128.0"
		}
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"64": "icons/icon-64.png"
	},
	"permissions": ["messagesRead"],
	"background": {
		"scripts": ["assets/background.js"],
		"type": "module"
	},
	"action": {
		"default_title": "Pixel Detector",
		"default_popup": "popup/index.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png"
		}
	},
	"message_display_action": {
		"default_title": "Pixel Detector",
		"default_popup": "popup/index.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	}
}
